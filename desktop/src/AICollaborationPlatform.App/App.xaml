<Application x:Class="AICollaborationPlatform.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:code="clr-namespace:AICollaborationPlatform.App.Features.Code"
             xmlns:jira="clr-namespace:AICollaborationPlatform.App.Features.Jira"
             xmlns:shell="clr-namespace:AICollaborationPlatform.App.Shell"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="UI/Themes/DarkTheme.xaml" />
                <ResourceDictionary Source="Features/Jira/JiraResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Page view model -> view mapping used by the main content area -->
            <DataTemplate DataType="{x:Type shell:HomeViewModel}">
                <shell:HomeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type jira:JiraViewModel}">
                <jira:JiraView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type jira:JiraDataViewModel}">
                <jira:JiraDataView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type code:CodeViewModel}">
                <code:CodeView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<UserControl x:Class="AICollaborationPlatform.App.Features.Code.CodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel Margin="0,0,16,0">
        <TextBlock Text="Code" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />

        <!-- Status line with a dot, like the Jira page -->
        <StackPanel Orientation="Horizontal" Margin="0,8,0,24">
            <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="{StaticResource InputBorderBrush}" />
            <TextBlock Margin="8,0,0,0" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                       Text="{Binding ConnectionStatus}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <!-- Not connected -->
        <Border Style="{StaticResource Card}" MaxWidth="520" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Connect a code host" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Margin="0,8,0,14" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                           Text="Connect your Git host to browse repositories and explore their files here. The connection is saved securely on this PC." />

                <!-- Supported hosts, as small grey tags -->
                <ItemsControl ItemsSource="{Binding SupportedHosts}" Margin="0,0,0,18" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,6,6" Padding="8,3" CornerRadius="3" Background="{StaticResource NeutralButtonBrush}">
                                <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource SidebarTextBrush}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="Connect…" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                        Command="{Binding ConnectCommand}" AutomationProperties.Name="Connect a code host" />
            </StackPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>
</UserControl>

<Window x:Class="AICollaborationPlatform.App.Features.Code.CodeConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:code="clr-namespace:AICollaborationPlatform.App.Features.Code"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=code:CodeConnectionViewModel}"
        Title="Connect a code host"
        Width="500" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CardBrush}"
        FontFamily="Segoe UI"
        FocusManager.FocusedElement="{Binding ElementName=HostList}">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- Each provider is a selectable row, drawn like the Jira dialog's Cloud / Server choice -->
        <Style x:Key="HostItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource InputBorderBrush}"
                                BorderThickness="1" CornerRadius="3" Padding="12,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ContentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource InfoBackgroundBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Bd" Property="Padding" Value="11,7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="28,24,28,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE943;" FontFamily="{StaticResource IconFont}" FontSize="20"
                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="Connect a code host" Margin="10,0,0,0" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                       Text="Choose where your repositories are. For a company server, enter its address."
                       Visibility="{Binding IsChoosingHost, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                       Visibility="{Binding IsSigningIn, Converter={StaticResource BoolToVisibility}}">
                <Run Text="{Binding SignInTitle, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SignInServer, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>

        <!-- Step 1: provider choice -->
        <StackPanel Grid.Row="1" Margin="28,12,28,0" Visibility="{Binding IsChoosingHost, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Provider" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
            <ListBox x:Name="HostList" ItemsSource="{Binding Hosts}" SelectedItem="{Binding SelectedHost}"
                     ItemContainerStyle="{StaticResource HostItem}" Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.TabNavigation="Once"
                     AutomationProperties.Name="Provider">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="4" Background="{Binding Color}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Letter}" Foreground="White" FontSize="14" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Description}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- The provider's own cloud, or a company server -->
            <StackPanel Margin="0,12,0,0" Visibility="{Binding HasCloud, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Hosted on" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                <UniformGrid Columns="2">
                    <RadioButton GroupName="Hosting" Style="{StaticResource SegmentRadio}" Margin="0,0,4,0"
                                 Content="{Binding SelectedHost.CloudName}" IsChecked="{Binding IsCloud}"
                                 AutomationProperties.Name="{Binding SelectedHost.CloudName}" />
                    <RadioButton GroupName="Hosting" Style="{StaticResource SegmentRadio}" Margin="4,0,0,0"
                                 Content="{Binding SelectedHost.SelfHostedName}" IsChecked="{Binding IsSelfHosted}"
                                 AutomationProperties.Name="{Binding SelectedHost.SelfHostedName}" />
                </UniformGrid>
            </StackPanel>

            <!-- Server address (self-hosted), or the repository URL for Other -->
            <StackPanel Margin="0,16,0,0" Visibility="{Binding ShowServerAddress, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ServerLabel}" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="ServerBox" Style="{StaticResource TextInput}"
                         Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{Binding ServerLabel}" />
                <TextBlock Style="{StaticResource FieldError}" Text="{Binding ServerAddressError}" />
                <TextBlock Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding ServerExample}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <!-- Hide the example while an error is shown in its place -->
                                <DataTrigger Binding="{Binding ServerAddressError}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <!-- Step 2: sign in with a token -->
        <StackPanel Grid.Row="1" Margin="28,12,28,0" Visibility="{Binding IsSigningIn, Converter={StaticResource BoolToVisibility}}">

            <!-- Username, only where the host needs one with the token (Bitbucket Cloud, Other) -->
            <StackPanel Margin="0,0,0,18" Visibility="{Binding ShowUsername, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding SignIn.UsernameLabel}" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="UsernameBox" Style="{StaticResource TextInput}"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{Binding SignIn.UsernameLabel, TargetNullValue=''}" />
                <TextBlock Style="{StaticResource FieldError}" Text="{Binding UsernameError}" />
            </StackPanel>

            <!-- Token, with a link to the page where it's created -->
            <DockPanel Margin="0,0,0,6" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="{Binding SignIn.TokenLabel}" Style="{StaticResource FieldLabel}" Margin="0" />
                <TextBlock DockPanel.Dock="Right" FontSize="12"
                           Visibility="{Binding SignIn.CreateTokenUrl, Converter={StaticResource StringToVisibility}}">
                    <Hyperlink NavigateUri="{Binding SignIn.CreateTokenUrl}" RequestNavigate="OnHyperlinkRequestNavigate"
                               Foreground="{StaticResource AccentBrush}">
                        <Run Text="{Binding SignIn.CreateTokenText, Mode=OneWay}" />
                    </Hyperlink>
                </TextBlock>
            </DockPanel>
            <Grid>
                <!-- PasswordBox can't data-bind its value, so the code-behind keeps it in sync with Token -->
                <PasswordBox x:Name="TokenBox" Style="{StaticResource PasswordInput}" Padding="10,8,40,8"
                             PasswordChanged="OnTokenBoxPasswordChanged"
                             Visibility="{Binding IsTokenVisible, Converter={StaticResource InverseBoolToVisibility}}"
                             AutomationProperties.Name="{Binding SignIn.TokenLabel}" />
                <TextBox Style="{StaticResource TextInput}" Padding="10,8,40,8"
                         Text="{Binding Token, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsTokenVisible, Converter={StaticResource BoolToVisibility}}"
                         AutomationProperties.Name="{Binding SignIn.TokenLabel}" />
                <Button HorizontalAlignment="Right" Margin="0,0,4,0" Command="{Binding ToggleTokenVisibilityCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="Content" Value="&#xE7B3;" />
                            <Setter Property="ToolTip" Value="Show token" />
                            <Setter Property="AutomationProperties.Name" Value="Show token" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTokenVisible}" Value="True">
                                    <Setter Property="Content" Value="&#xED1A;" />
                                    <Setter Property="ToolTip" Value="Hide token" />
                                    <Setter Property="AutomationProperties.Name" Value="Hide token" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
            <TextBlock Style="{StaticResource FieldError}" Text="{Binding TokenError}" />

            <!-- The read-only permissions the token needs -->
            <Border Margin="0,14,0,0" CornerRadius="6" Padding="12,10" Background="{StaticResource ContentBrush}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Margin="0,1,10,0" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Top" />
                    <StackPanel>
                        <TextBlock Text="Read-only access is enough" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding SignIn.Permissions}" Margin="0,3,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="The token is kept in Windows Credential Manager, never in plain files or logs." Margin="0,6,0,0"
                                   FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- What happens next, after Sign in -->
            <Border Margin="0,14,0,0" CornerRadius="6" Padding="12,10" Background="{StaticResource InfoBackgroundBrush}"
                    Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding StatusMessage}" FontSize="13" TextWrapping="Wrap"
                           Foreground="{StaticResource TextPrimaryBrush}" AutomationProperties.LiveSetting="Polite" />
            </Border>
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="28,16" Background="{StaticResource ContentBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <!-- Enter presses the main button of the step that's showing -->
                <Button DockPanel.Dock="Left" Content="Back" Style="{StaticResource SecondaryButton}"
                        Command="{Binding BackCommand}"
                        Visibility="{Binding IsSigningIn, Converter={StaticResource BoolToVisibility}}" />
                <Button DockPanel.Dock="Right" Content="Continue" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                        IsDefault="{Binding IsChoosingHost}" Command="{Binding ContinueCommand}"
                        Visibility="{Binding IsChoosingHost, Converter={StaticResource BoolToVisibility}}" />
                <Button DockPanel.Dock="Right" Content="Sign in" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                        IsDefault="{Binding IsSigningIn}" Command="{Binding SignInToHostCommand}"
                        Visibility="{Binding IsSigningIn, Converter={StaticResource BoolToVisibility}}" />
                <Button DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource SecondaryButton}"
                        Command="{Binding CancelCommand}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>

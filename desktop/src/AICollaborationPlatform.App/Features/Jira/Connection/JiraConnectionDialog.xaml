<Window x:Class="AICollaborationPlatform.App.Views.JiraConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AICollaborationPlatform.App.ViewModels"
        xmlns:local="clr-namespace:AICollaborationPlatform.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:JiraConnectionViewModel}"
        Title="Connect to Jira"
        Width="500" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CardBrush}"
        FontFamily="Segoe UI"
        FocusManager.FocusedElement="{Binding ElementName=UrlBox}">
    <Window.InputBindings>
        <!-- Esc cancels a running test first, then closes (see JiraConnectionViewModel.Cancel) -->
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="28,24,28,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE71B;" FontFamily="{StaticResource IconFont}" FontSize="20"
                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="Connect to Jira" Margin="10,0,0,0" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                       Text="Enter your Jira address and credentials. We'll check them before connecting." />
        </StackPanel>

        <!-- Form -->
        <StackPanel Grid.Row="1" Margin="28,12,28,0">

            <!-- URL -->
            <TextBlock Text="Jira URL" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="UrlBox" Style="{StaticResource TextInput}"
                     Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Jira URL" />
            <TextBlock Style="{StaticResource FieldError}" Text="{Binding UrlError}" />
            <TextBlock Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                       Text="For example: https://your-company.atlassian.net">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <!-- Hide the example while an error is shown in its place -->
                            <DataTrigger Binding="{Binding UrlError}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Auth type -->
            <TextBlock Text="Jira type" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
            <UniformGrid Columns="2">
                <RadioButton Content="Jira Cloud" GroupName="AuthType" Style="{StaticResource SegmentRadio}" Margin="0,0,4,0"
                             IsChecked="{Binding IsCloud}" AutomationProperties.Name="Jira Cloud" />
                <RadioButton Content="Jira Server / Data Center" GroupName="AuthType" Style="{StaticResource SegmentRadio}" Margin="4,0,0,0"
                             IsChecked="{Binding IsServer}" AutomationProperties.Name="Jira Server or Data Center" />
            </UniformGrid>

            <!-- Email (Cloud only) -->
            <StackPanel Visibility="{Binding IsCloud, Converter={StaticResource BoolToVisibility}}" Margin="0,18,0,0">
                <TextBlock Text="Email" Style="{StaticResource FieldLabel}" />
                <TextBox Style="{StaticResource TextInput}"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Email" />
                <TextBlock Style="{StaticResource FieldError}" Text="{Binding EmailError}" />
            </StackPanel>

            <!-- Token -->
            <DockPanel Margin="0,18,0,6" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="{Binding TokenLabel}" Style="{StaticResource FieldLabel}" Margin="0" />
                <TextBlock DockPanel.Dock="Right" FontSize="12">
                    <Hyperlink NavigateUri="{Binding TokenHelpUrl}" RequestNavigate="OnHyperlinkRequestNavigate"
                               Foreground="{StaticResource AccentBrush}">
                        <Run Text="{Binding TokenHelpText, Mode=OneWay}" />
                    </Hyperlink>
                </TextBlock>
            </DockPanel>
            <Grid>
                <!-- PasswordBox can't data-bind its value, so the code-behind keeps it in sync with Token -->
                <PasswordBox x:Name="TokenBox" Style="{StaticResource PasswordInput}" Padding="10,8,40,8"
                             PasswordChanged="OnTokenBoxPasswordChanged"
                             Visibility="{Binding IsTokenVisible, Converter={StaticResource InverseBoolToVisibility}}"
                             AutomationProperties.Name="{Binding TokenLabel}" />
                <TextBox Style="{StaticResource TextInput}" Padding="10,8,40,8"
                         Text="{Binding Token, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsTokenVisible, Converter={StaticResource BoolToVisibility}}"
                         AutomationProperties.Name="{Binding TokenLabel}" />
                <Button HorizontalAlignment="Right" Margin="0,0,4,0" Command="{Binding ToggleTokenVisibilityCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="Content" Value="&#xE7B3;" />
                            <Setter Property="ToolTip" Value="Show token" />
                            <Setter Property="AutomationProperties.Name" Value="Show token" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTokenVisible}" Value="True">
                                    <Setter Property="Content" Value="&#xED1A;" />
                                    <Setter Property="ToolTip" Value="Hide token" />
                                    <Setter Property="AutomationProperties.Name" Value="Hide token" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
            <TextBlock Style="{StaticResource FieldError}" Text="{Binding TokenError}" />

            <!-- Connection status -->
            <Border Margin="0,20,0,0" CornerRadius="6" Padding="12,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusKind}" Value="None">
                                <Setter Property="Background" Value="{StaticResource ContentBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusKind}" Value="Working">
                                <Setter Property="Background" Value="{StaticResource InfoBackgroundBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusKind}" Value="Success">
                                <Setter Property="Background" Value="{StaticResource SuccessBackgroundBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                                <Setter Property="Background" Value="{StaticResource ErrorBackgroundBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Spinner while working -->
                    <local:Spinner Grid.Column="0" Margin="0,1,10,0" VerticalAlignment="Top">
                        <local:Spinner.Style>
                            <Style TargetType="local:Spinner">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusKind}" Value="Working">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </local:Spinner.Style>
                    </local:Spinner>

                    <!-- Icon for success / error -->
                    <TextBlock Grid.Column="0" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,1,10,0"
                               VerticalAlignment="Top">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusKind}" Value="Success">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Text" Value="&#xE73E;" />
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Text" Value="&#xE783;" />
                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="13" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextPrimaryBrush}" AutomationProperties.LiveSetting="Polite" />
                        <Expander Header="Details" FontSize="12" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                                  Visibility="{Binding StatusDetails, Converter={StaticResource StringToVisibility}}">
                            <TextBox Text="{Binding StatusDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                     BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="11"
                                     Foreground="{StaticResource TextSecondaryBrush}" CaretBrush="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                        </Expander>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="2" Margin="0,24,0,0" Padding="28,16" Background="{StaticResource ContentBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Test Connection" Style="{StaticResource SecondaryButton}"
                        Command="{Binding TestConnectionCommand}" />
                <Button DockPanel.Dock="Right" Content="Connect" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                        IsDefault="True" Command="{Binding ConnectCommand}" />
                <Button DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource SecondaryButton}"
                        Command="{Binding CancelCommand}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>

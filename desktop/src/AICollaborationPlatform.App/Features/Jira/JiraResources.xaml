<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:jira="clr-namespace:AICollaborationPlatform.App.Features.Jira">
    <!-- Jira visuals shared by the Jira pages: status lozenges, issue type and priority icons, avatars. -->

    <!-- Converters -->
    <jira:IssueTypeIconConverter x:Key="TypeIcon" />
    <jira:PriorityIconConverter x:Key="PriorityIcon" />
    <jira:InitialsConverter x:Key="Initials" />
    <jira:AvatarColorConverter x:Key="AvatarColor" />
    <jira:UpperCaseConverter x:Key="UpperCase" />

    <!-- Jira's status lozenge: small, bold, upper-case, coloured by status category (new / indeterminate / done).
         TextElement.Foreground flows down to the TextBlock inside. -->
    <Style x:Key="StatusPill" TargetType="Border">
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="5,1" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{x:Static jira:JiraVisuals.StatusNewBackground}" />
        <Setter Property="TextElement.Foreground" Value="{x:Static jira:JiraVisuals.StatusNewForeground}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding StatusCategory}" Value="indeterminate">
                <Setter Property="Background" Value="{x:Static jira:JiraVisuals.StatusInProgressBackground}" />
                <Setter Property="TextElement.Foreground" Value="{x:Static jira:JiraVisuals.StatusInProgressForeground}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusCategory}" Value="done">
                <Setter Property="Background" Value="{x:Static jira:JiraVisuals.StatusDoneBackground}" />
                <Setter Property="TextElement.Foreground" Value="{x:Static jira:JiraVisuals.StatusDoneForeground}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusPillText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Small reusable Jira visuals. Each template's DataContext is a plain string (type, priority or name);
         bind Content with TargetNullValue='' so a missing value still reaches the template as "". -->
    <DataTemplate x:Key="IssueTypeIconTemplate">
        <Border Width="16" Height="16" CornerRadius="3" Background="{Binding Converter={StaticResource TypeIcon}}"
                ToolTip="{Binding}" AutomationProperties.Name="{Binding}">
            <Path Data="{Binding Converter={StaticResource TypeIcon}, ConverterParameter=shape}" Fill="White" />
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="PriorityIconTemplate">
        <Path Width="16" Height="16" Data="{Binding Converter={StaticResource PriorityIcon}, ConverterParameter=shape}"
              Stroke="{Binding Converter={StaticResource PriorityIcon}}" StrokeThickness="1.8"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
    </DataTemplate>

    <!-- Round avatar with initials; a grey person icon when unassigned -->
    <DataTemplate x:Key="AvatarTemplate">
        <Grid Width="24" Height="24">
            <Ellipse Fill="{Binding Converter={StaticResource AvatarColor}}" />
            <TextBlock x:Name="Letters" Text="{Binding Converter={StaticResource Initials}}" Foreground="White" FontSize="10"
                       FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock x:Name="Person" Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding}" Value="">
                <Setter TargetName="Person" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Square project avatar with the project key's first letter -->
    <DataTemplate x:Key="ProjectAvatarTemplate">
        <Border Width="24" Height="24" CornerRadius="4" Background="{Binding Converter={StaticResource AvatarColor}}">
            <Grid>
                <TextBlock x:Name="Letter" Text="{Binding Converter={StaticResource Initials}}" Foreground="White" FontSize="12"
                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock x:Name="All" Text="&#xE8A9;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding}" Value="">
                <Setter TargetName="All" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>

<UserControl x:Class="AICollaborationPlatform.App.Views.JiraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AICollaborationPlatform.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel Margin="0,0,16,0">
        <TextBlock Text="Jira" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />

        <!-- Status line with a coloured dot -->
        <StackPanel Orientation="Horizontal" Margin="0,8,0,24">
            <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="{StaticResource InputBorderBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Connected">
                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Restoring">
                                <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="NeedsAttention">
                                <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
            <TextBlock Margin="8,0,0,0" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                       Text="{Binding ConnectionStatus}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <!-- Not connected -->
        <Border Style="{StaticResource Card}" MaxWidth="520" HorizontalAlignment="Left"
                Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="Connect to Jira" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Margin="0,8,0,18" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                           Text="Enter your Jira URL and credentials to connect. Works with Jira Cloud and Jira Server / Data Center. The connection is saved securely on this PC." />
                <Button Content="Connect…" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                        Command="{Binding ConnectCommand}" AutomationProperties.Name="Connect to Jira" />
            </StackPanel>
        </Border>

        <!-- Reconnecting to the saved connection -->
        <Border Style="{StaticResource Card}" MaxWidth="520" HorizontalAlignment="Left"
                Visibility="{Binding IsRestoring, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <local:Spinner Width="18" Height="18" VerticalAlignment="Center" />
                <StackPanel Margin="14,0,0,0">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding ConnectedUrl}" Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Saved connection needs attention -->
        <Border Style="{StaticResource Card}" MaxWidth="520" HorizontalAlignment="Left"
                Visibility="{Binding NeedsAttention, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="18"
                               Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Couldn't reconnect" Margin="10,0,0,0" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="6" Background="{StaticResource WarningBackgroundBrush}">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" />
                </Border>
                <TextBlock Margin="0,12,0,0" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Text="Saved Jira site" />
                <TextBlock Margin="0,2,0,18" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"
                           Text="{Binding ConnectedUrl}" TextTrimming="CharacterEllipsis" />
                <WrapPanel>
                    <Button Content="Retry" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                            Command="{Binding RetryCommand}" />
                    <Button Content="Fix connection…" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Command="{Binding ConnectCommand}" />
                    <Button Content="Forget" Style="{StaticResource SecondaryButton}"
                            Command="{Binding DisconnectCommand}" AutomationProperties.Name="Forget saved connection" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Connected -->
        <Border Style="{StaticResource Card}" MaxWidth="520" HorizontalAlignment="Left"
                Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="Connected" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Margin="0,8,0,0" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Text="Jira site" />
                <TextBlock Margin="0,2,0,12" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"
                           Text="{Binding ConnectedUrl}" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="12"
                               Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock Margin="6,0,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                               Text="Token saved securely in Windows Credential Manager" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Change connection…" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ConnectCommand}" />
                    <Button Content="Disconnect" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                            Command="{Binding DisconnectCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Fetch data (connected only) -->
        <Border Style="{StaticResource Card}" MaxWidth="640" HorizontalAlignment="Left" Margin="0,16,0,24"
                DataContext="{Binding Fetch}"
                Visibility="{Binding DataContext.IsConnected, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="18"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Fetch data" Margin="10,0,0,0" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                           Text="{Binding LocalDataText, StringFormat=Local copy: {0}}" />

                <!-- Which projects -->
                <TextBlock Text="Projects" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
                <UniformGrid Columns="2" IsEnabled="{Binding IsFetching, Converter={StaticResource InverseBool}}">
                    <RadioButton Content="All projects" GroupName="FetchScope" Style="{StaticResource SegmentRadio}" Margin="0,0,4,0"
                                 IsChecked="{Binding IsAllProjects}" />
                    <RadioButton Content="Selected projects" GroupName="FetchScope" Style="{StaticResource SegmentRadio}" Margin="4,0,0,0"
                                 IsChecked="{Binding IsSelectedProjects}" />
                </UniformGrid>

                <StackPanel Margin="0,10,0,0" Visibility="{Binding IsSelectedProjects, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding SelectedCountText}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right" FontSize="12" VerticalAlignment="Center">
                            <Hyperlink Command="{Binding SelectAllProjectsCommand}" Foreground="{StaticResource AccentBrush}">All</Hyperlink>
                            <Run Text=" · " Foreground="{StaticResource TextSecondaryBrush}" />
                            <Hyperlink Command="{Binding SelectNoProjectsCommand}" Foreground="{StaticResource AccentBrush}">None</Hyperlink>
                            <Run Text=" · " Foreground="{StaticResource TextSecondaryBrush}" />
                            <Hyperlink Command="{Binding LoadProjectsCommand}" Foreground="{StaticResource AccentBrush}">Reload</Hyperlink>
                        </TextBlock>
                    </DockPanel>
                    <Border BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" MaxHeight="200">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,6">
                                <ItemsControl ItemsSource="{Binding Projects}" IsEnabled="{Binding IsFetching, Converter={StaticResource InverseBool}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,4"
                                                      FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel Orientation="Horizontal" Margin="12,10"
                                        Visibility="{Binding IsLoadingProjects, Converter={StaticResource BoolToVisibility}}">
                                <local:Spinner />
                                <TextBlock Text="Loading projects…" Margin="8,0,0,0" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding ProjectsError}" />
                </StackPanel>

                <!-- Filter and options -->
                <TextBlock Text="JQL filter (optional)" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
                <TextBox Style="{StaticResource TextInput}" Text="{Binding JqlFilter, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Consolas" AutomationProperties.Name="JQL filter"
                         IsEnabled="{Binding IsFetching, Converter={StaticResource InverseBool}}" />
                <TextBlock Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                           Text="Added to each project's search. Examples: updated &gt;= -30d · status != Done · assignee = currentUser()" />

                <CheckBox Margin="0,14,0,0" IsChecked="{Binding FullRefresh}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                          IsEnabled="{Binding IsFetching, Converter={StaticResource InverseBool}}">
                    <TextBlock TextWrapping="Wrap" Text="Full refresh: download everything again, not just what changed since the last fetch" />
                </CheckBox>

                <!-- Progress -->
                <StackPanel Margin="0,18,0,0" Visibility="{Binding IsFetching, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <local:Spinner />
                        <TextBlock Text="{Binding ProgressText}" Margin="8,0,0,0" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <ProgressBar Style="{StaticResource ThinProgressBar}" Margin="0,10,0,0" Value="{Binding ProgressValue}"
                                 Visibility="{Binding IsProgressIndeterminate, Converter={StaticResource InverseBoolToVisibility}}"
                                 AutomationProperties.Name="Fetch progress" />
                </StackPanel>

                <!-- Actions -->
                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <Button Content="Fetch data" Style="{StaticResource PrimaryButton}" Command="{Binding FetchCommand}"
                            Visibility="{Binding IsFetching, Converter={StaticResource InverseBoolToVisibility}}" />
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}"
                            Visibility="{Binding IsFetching, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.Name="Cancel fetch" />
                </StackPanel>

                <!-- Result -->
                <Border Margin="0,16,0,0" Padding="12,10" CornerRadius="6">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ResultKind}" Value="None">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ResultKind}" Value="Success">
                                    <Setter Property="Background" Value="{StaticResource SuccessBackgroundBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ResultKind}" Value="Warning">
                                    <Setter Property="Background" Value="{StaticResource WarningBackgroundBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ResultKind}" Value="Error">
                                    <Setter Property="Background" Value="{StaticResource ErrorBackgroundBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding ResultMessage}" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"
                                   AutomationProperties.LiveSetting="Polite" />
                        <ItemsControl ItemsSource="{Binding ResultWarnings}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat=• {0}}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>
</UserControl>

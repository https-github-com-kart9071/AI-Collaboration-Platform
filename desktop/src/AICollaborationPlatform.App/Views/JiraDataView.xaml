<UserControl x:Class="AICollaborationPlatform.App.Views.JiraDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AICollaborationPlatform.App.ViewModels"
             xmlns:local="clr-namespace:AICollaborationPlatform.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:JiraDataViewModel}">
    <UserControl.Resources>
        <!-- Section headings inside the issue panel ("Description", "Details", "Activity") -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,22,0,8" />
        </Style>
        <Style x:Key="FieldName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,7" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,7" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
        <!-- Read-only text people can still select and copy -->
        <Style x:Key="SelectableText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
        <!-- What the last change did ("Comment added.") or why it didn't work; coloured by outcome. DataContext: the editor. -->
        <Style x:Key="EditorBanner" TargetType="Border">
            <Setter Property="Padding" Value="20,9" />
            <Setter Property="Background" Value="{StaticResource NeutralButtonBrush}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Message}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding MessageKind}" Value="Success">
                    <Setter Property="Background" Value="{StaticResource SuccessBackgroundBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding MessageKind}" Value="Warning">
                    <Setter Property="Background" Value="{StaticResource WarningBackgroundBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding MessageKind}" Value="Error">
                    <Setter Property="Background" Value="{StaticResource ErrorBackgroundBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource ErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- A row in the assignee picker -->
        <Style x:Key="PersonItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderThickness="2,0,0,0" BorderBrush="Transparent" Padding="10,5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource NeutralButtonBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource InfoBackgroundBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: breadcrumb, project title, refresh -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock FontSize="14" Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="Jira data" />
                    <Run Text="  /  " />
                    <Run Text="{Binding Site, Mode=OneWay, TargetNullValue=Local copy}" />
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ContentPresenter Content="{Binding SelectedProject.Key, TargetNullValue=''}" ContentTemplate="{StaticResource ProjectAvatarTemplate}"
                                      VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding SelectedProject.Label, TargetNullValue=Issues}" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <local:Spinner VerticalAlignment="Center" Margin="0,0,10,0">
                    <local:Spinner.Style>
                        <Style TargetType="local:Spinner">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </local:Spinner.Style>
                </local:Spinner>
                <!-- What Refresh is doing, or how it went; coloured by outcome -->
                <TextBlock Text="{Binding RefreshMessage}" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"
                           MaxWidth="520" TextTrimming="CharacterEllipsis" ToolTip="{Binding RefreshMessage}"
                           AutomationProperties.Name="Refresh status" AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RefreshKind}" Value="Success">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RefreshKind}" Value="Warning">
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RefreshKind}" Value="Error">
                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding CancelRefreshCommand}" Padding="12,6" Margin="0,0,8,0"
                        Content="Cancel" AutomationProperties.Name="Cancel refresh"
                        Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Padding="12,6"
                        AutomationProperties.Name="Refresh data" ToolTip="Get the latest changes from Jira">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="Refresh" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Main area: projects | issues (+ issue panel on top) -->
        <Grid Grid.Row="1" Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Projects -->
            <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="3" Padding="6,10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="PROJECTS" Margin="10,2,10,8" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <ListBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}"
                             BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.ScrollUnit="Pixel" local:SmoothScroll.IsEnabled="True"
                             AutomationProperties.Name="Projects">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" CornerRadius="3" Padding="8,6" Margin="0,1" Background="Transparent"
                                                    BorderThickness="2,0,0,0" BorderBrush="Transparent">
                                                <DockPanel>
                                                    <ContentPresenter DockPanel.Dock="Left" Content="{Binding Key, TargetNullValue=''}"
                                                                      ContentTemplate="{StaticResource ProjectAvatarTemplate}" Margin="0,0,10,0" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding IssueCount, StringFormat=N0}" FontSize="12"
                                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                    <TextBlock x:Name="Label" Text="{Binding Label}" FontSize="14" TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                                                               ToolTip="{Binding Label}" />
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource NeutralButtonBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource InfoBackgroundBrush}" />
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Issues -->
            <DockPanel Grid.Column="2">
                <!-- Filter bar: search + Jira-style filter buttons -->
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Grid Width="260" Margin="0,0,8,8">
                        <TextBox x:Name="SearchBox" Style="{StaticResource TextInput}" Padding="32,6,10,6"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Search issues" />
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="11,0,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock Text="Search issues" Margin="33,0,0,0" FontSize="14" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <ComboBox Style="{StaticResource FilterCombo}" MinWidth="120" MaxWidth="240" Margin="0,0,8,8"
                              ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}"
                              AutomationProperties.Name="Filter by status" />
                    <ComboBox Style="{StaticResource FilterCombo}" MinWidth="120" MaxWidth="240" Margin="0,0,8,8"
                              ItemsSource="{Binding AssigneeOptions}" SelectedItem="{Binding SelectedAssignee}"
                              AutomationProperties.Name="Filter by assignee" />
                    <ComboBox Style="{StaticResource FilterCombo}" MinWidth="110" MaxWidth="240" Margin="0,0,8,8"
                              ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedType}"
                              AutomationProperties.Name="Filter by type" />
                    <TextBlock Margin="6,0,0,8" VerticalAlignment="Center" FontSize="14">
                        <Hyperlink Command="{Binding ClearFiltersCommand}" Foreground="{StaticResource AccentBrush}"
                                   TextDecorations="{x:Null}">Clear filters</Hyperlink>
                    </TextBlock>
                </WrapPanel>

                <TextBlock DockPanel.Dock="Bottom" Margin="2,10,0,0" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                           Text="{Binding CountText}" AutomationProperties.LiveSetting="Polite" />

                <Grid>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="3" Padding="1">
                        <DataGrid x:Name="IssuesGrid" Style="{StaticResource DataTable}"
                                  ItemsSource="{Binding Issues}" SelectedItem="{Binding SelectedIssue}"
                                  Sorting="OnSorting" MouseDoubleClick="OnRowDoubleClick" PreviewKeyDown="OnGridKeyDown"
                                  local:SmoothScroll.IsEnabled="True"
                                  AutomationProperties.Name="Issues">
                            <!-- Cells bind straight to IssueRow's ready-made visuals. Icons are shared, pre-drawn images rather than
                                 Paths: every row scrolling into view re-lays-out its cells, and Paths are slow to measure. -->
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Type" SortMemberPath="Type" Width="58">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                   Source="{Binding TypeIcon}" ToolTip="{Binding Type}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Key" Binding="{Binding Key}" SortMemberPath="Key" Width="96"
                                                    ElementStyle="{StaticResource CellText}" Foreground="{StaticResource AccentBrush}" />
                                <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" SortMemberPath="Summary" Width="*" MinWidth="200"
                                                    ElementStyle="{StaticResource CellText}" />
                                <DataGridTemplateColumn Header="Status" SortMemberPath="Status" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="3" Padding="5,1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Background="{Binding StatusBackground}" ToolTip="{Binding Status}">
                                                <TextBlock Style="{StaticResource StatusPillText}" Text="{Binding StatusText}" Foreground="{Binding StatusForeground}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Assignee" SortMemberPath="Assignee" Width="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <DockPanel VerticalAlignment="Center">
                                                <Grid DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,8,0">
                                                    <Ellipse Fill="{Binding AssigneeColor}" />
                                                    <TextBlock Text="{Binding AssigneeInitials}" Foreground="White" FontSize="10" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding IsUnassigned, Converter={StaticResource BoolToVisibility}}" />
                                                </Grid>
                                                <TextBlock Style="{StaticResource CellText}" Text="{Binding Assignee, TargetNullValue=Unassigned}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Priority" SortMemberPath="Priority" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <DockPanel VerticalAlignment="Center">
                                                <Image DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,6,0" Source="{Binding PriorityIcon}" />
                                                <TextBlock Style="{StaticResource CellText}" Text="{Binding Priority}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Created" Binding="{Binding Created, StringFormat=d MMM yyyy}" SortMemberPath="Created" Width="104"
                                                    ElementStyle="{StaticResource CellSubtleText}" />
                                <DataGridTextColumn Header="Updated" Binding="{Binding Updated, StringFormat=d MMM yyyy}" SortMemberPath="Updated" Width="104"
                                                    ElementStyle="{StaticResource CellSubtleText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- No results for the current filters -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Issues.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="28" HorizontalAlignment="Center"
                                   Foreground="{StaticResource InputBorderBrush}" />
                        <TextBlock Text="No issues match these filters" Margin="0,10,0,0" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Try a different search or clear the filters." Margin="0,4,0,0" FontSize="14"
                                   HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <!-- Issue panel, like Jira's issue view. It sits on top of the table so the columns keep their width. -->
                    <Border x:Name="DetailDrawer" Width="640" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                            HorizontalAlignment="Right" Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3"
                            Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibility}}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.16" Direction="180" />
                        </Border.Effect>
                        <Grid>
                            <DockPanel DataContext="{Binding Detail}" Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                                <!-- Top bar: type icon + key breadcrumb, actions -->
                                <Border DockPanel.Dock="Top" Padding="20,12,12,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="13" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.OpenInJiraCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Key}" AutomationProperties.Name="Open in Jira" ToolTip="Open this issue in your browser">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                                    <TextBlock Text="Open in Jira" Margin="7,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Close (Esc)"
                                                    AutomationProperties.Name="Close details"
                                                    Command="{Binding DataContext.CloseDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ContentPresenter Content="{Binding Type, TargetNullValue=''}" ContentTemplate="{StaticResource IssueTypeIconTemplate}"
                                                              VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Key}" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Why changes can't be made right now (e.g. not connected) -->
                                <Border DockPanel.Dock="Top" Padding="20,9" Background="{StaticResource InfoBackgroundBrush}"
                                        DataContext="{Binding DataContext.Editor, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Visibility="{Binding CannotEditReason, Converter={StaticResource StringToVisibility}}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                   Foreground="{StaticResource AccentBrush}" Margin="0,1,10,0" VerticalAlignment="Top" />
                                        <TextBlock Text="{Binding CannotEditReason}" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"
                                                   AutomationProperties.Name="Why editing is off" />
                                    </DockPanel>
                                </Border>

                                <!-- How the last change went -->
                                <Border DockPanel.Dock="Top" Style="{StaticResource EditorBanner}"
                                        DataContext="{Binding DataContext.Editor, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <DockPanel>
                                        <local:Spinner DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center"
                                                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding Message}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"
                                                   AutomationProperties.Name="Edit status" AutomationProperties.LiveSetting="Polite" />
                                    </DockPanel>
                                </Border>

                                <!-- Everything below scrolls as one page, like Jira -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto" local:SmoothScroll.IsEnabled="True" local:SmoothScroll.PixelsPerNotch="120">
                                    <StackPanel Margin="24,18,24,28">
                                        <!-- Summary: read-only until the pencil is clicked; Enter saves, Esc cancels -->
                                        <Grid DataContext="{Binding DataContext.Editor, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <DockPanel Visibility="{Binding IsEditingSummary, Converter={StaticResource InverseBoolToVisibility}}">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE70F;" VerticalAlignment="Top"
                                                        Margin="8,2,0,0" ToolTip="Edit summary" AutomationProperties.Name="Edit summary"
                                                        Command="{Binding EditSummaryCommand}"
                                                        Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBox Text="{Binding Issue.Summary, Mode=OneWay}" Style="{StaticResource SelectableText}" FontSize="22" FontWeight="SemiBold"
                                                         AutomationProperties.Name="Summary" />
                                            </DockPanel>
                                            <StackPanel Visibility="{Binding IsEditingSummary, Converter={StaticResource BoolToVisibility}}">
                                                <TextBox Style="{StaticResource TextInput}" FontSize="20" FontWeight="SemiBold" MaxLength="255"
                                                         Text="{Binding SummaryDraft, UpdateSourceTrigger=PropertyChanged}"
                                                         IsVisibleChanged="OnEditorShown" AutomationProperties.Name="Summary editor">
                                                    <TextBox.InputBindings>
                                                        <KeyBinding Key="Enter" Command="{Binding SaveSummaryCommand}" />
                                                    </TextBox.InputBindings>
                                                </TextBox>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                                    <Button Style="{StaticResource PrimaryButton}" Content="Save" Padding="14,6"
                                                            Command="{Binding SaveSummaryCommand}" AutomationProperties.Name="Save summary" />
                                                    <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Padding="14,6" Margin="8,0,0,0"
                                                            Command="{Binding CancelSummaryCommand}" AutomationProperties.Name="Cancel summary" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <Border Style="{StaticResource StatusPill}" Margin="0,14,0,0" Padding="8,4">
                                            <TextBlock Style="{StaticResource StatusPillText}" FontSize="12"
                                                       Text="{Binding Status, Converter={StaticResource UpperCase}}" />
                                        </Border>

                                        <!-- Description: edit in place with Save / Cancel -->
                                        <StackPanel DataContext="{Binding DataContext.Editor, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <DockPanel Margin="0,22,0,8">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE70F;"
                                                        ToolTip="Edit description" AutomationProperties.Name="Edit description"
                                                        Command="{Binding EditDescriptionCommand}">
                                                    <Button.Visibility>
                                                        <MultiBinding Converter="{StaticResource AllTrueToVisibility}">
                                                            <Binding Path="CanEdit" />
                                                            <Binding Path="IsEditingDescription" Converter="{StaticResource InverseBool}" />
                                                        </MultiBinding>
                                                    </Button.Visibility>
                                                </Button>
                                                <TextBlock Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" Text="Description" />
                                            </DockPanel>
                                            <TextBox Text="{Binding Issue.Description, Mode=OneWay, TargetNullValue=No description.}"
                                                     Style="{StaticResource SelectableText}" AutomationProperties.Name="Description"
                                                     Visibility="{Binding IsEditingDescription, Converter={StaticResource InverseBoolToVisibility}}" />
                                            <StackPanel Visibility="{Binding IsEditingDescription, Converter={StaticResource BoolToVisibility}}">
                                                <TextBox Style="{StaticResource TextArea}" MinHeight="140" MaxHeight="420"
                                                         Text="{Binding DescriptionDraft, UpdateSourceTrigger=PropertyChanged}"
                                                         IsVisibleChanged="OnEditorShown" AutomationProperties.Name="Description editor" />
                                                <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                                                           Text="Saving replaces any formatting in Jira (bold, lists, links, images) with this plain text."
                                                           Visibility="{Binding DescriptionLosesFormatting, Converter={StaticResource BoolToVisibility}}" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                                    <Button Style="{StaticResource PrimaryButton}" Content="Save" Padding="14,6"
                                                            Command="{Binding SaveDescriptionCommand}" AutomationProperties.Name="Save description" />
                                                    <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Padding="14,6" Margin="8,0,0,0"
                                                            Command="{Binding CancelDescriptionCommand}" AutomationProperties.Name="Cancel description" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Attachments, only when there are some -->
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Attachments.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Style="{StaticResource SectionTitle}"
                                                       Text="{Binding Attachments.Count, StringFormat=Attachments ({0})}" />
                                            <ItemsControl ItemsSource="{Binding Attachments}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="180" Margin="0,0,10,10" Padding="10" CornerRadius="3"
                                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ToolTip="{Binding Filename}">
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Left" Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                                                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Filename}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis">
                                                                        <Run Text="{Binding SizeText, Mode=OneWay}" />
                                                                        <Run Text="{Binding Created, Mode=OneWay, StringFormat= · d MMM yyyy}" />
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- Details box, like the right-hand panel in Jira -->
                                        <Border Margin="0,22,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                                            <StackPanel>
                                                <Border Padding="14,8" MinHeight="44" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="13"
                                                                DataContext="{Binding DataContext.Editor, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                Command="{Binding EditDetailsCommand}" AutomationProperties.Name="Edit details"
                                                                ToolTip="Change status, assignee or priority">
                                                            <Button.Visibility>
                                                                <MultiBinding Converter="{StaticResource AllTrueToVisibility}">
                                                                    <Binding Path="CanEdit" />
                                                                    <Binding Path="IsEditingDetails" Converter="{StaticResource InverseBool}" />
                                                                </MultiBinding>
                                                            </Button.Visibility>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                                                <TextBlock Text="Edit" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                        <TextBlock Text="Details" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                                    </DockPanel>
                                                </Border>

                                                <!-- Editing status, assignee and priority. Each starts on "(current)"; Save sends only what was changed. -->
                                                <StackPanel Margin="14,12,14,16"
                                                            DataContext="{Binding DataContext.Editor, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Visibility="{Binding IsEditingDetails, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Status" />
                                                    <ComboBox Style="{StaticResource FilterCombo}" MinWidth="260" HorizontalAlignment="Left"
                                                              ItemsSource="{Binding StatusChoices}" SelectedItem="{Binding SelectedStatus}"
                                                              AutomationProperties.Name="Status" />
                                                    <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                                               Text="Only the moves your Jira workflow allows from here are listed." />

                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Assignee" Margin="0,16,0,6" />
                                                    <Grid>
                                                        <TextBox Style="{StaticResource TextInput}" Padding="32,6,10,6"
                                                                 Text="{Binding AssigneeSearch, UpdateSourceTrigger=PropertyChanged}"
                                                                 AutomationProperties.Name="Search people" />
                                                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="11,0,0,0"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" IsHitTestVisible="False" />
                                                        <TextBlock Style="{StaticResource Placeholder}" Tag="{Binding AssigneeSearch}" Text="Search people by name or email"
                                                                   Margin="33,0,0,0" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <ListBox Margin="0,6,0,0" MaxHeight="216" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                             ItemsSource="{Binding AssigneeChoices}" SelectedItem="{Binding SelectedAssignee}"
                                                             ItemContainerStyle="{StaticResource PersonItem}" AutomationProperties.Name="Assignee"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" AutomationProperties.Name="{Binding Name}">
                                                                    <ContentPresenter Content="{Binding AvatarName}" ContentTemplate="{StaticResource AvatarTemplate}"
                                                                                      VerticalAlignment="Center" Margin="0,0,10,0" />
                                                                    <TextBlock Text="{Binding Name}" FontSize="14" VerticalAlignment="Center"
                                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                                    <TextBlock Text="  (current)" FontSize="13" VerticalAlignment="Center"
                                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                                               Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>

                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Priority" Margin="0,16,0,6" />
                                                    <ComboBox Style="{StaticResource FilterCombo}" MinWidth="260" HorizontalAlignment="Left"
                                                              ItemsSource="{Binding PriorityChoices}" SelectedItem="{Binding SelectedPriority}"
                                                              AutomationProperties.Name="Priority" />

                                                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                                        <Button Style="{StaticResource PrimaryButton}" Content="Save" Padding="14,6"
                                                                Command="{Binding SaveDetailsCommand}" AutomationProperties.Name="Save details" />
                                                        <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Padding="14,6" Margin="8,0,0,0"
                                                                Command="{Binding CancelDetailsCommand}" AutomationProperties.Name="Cancel details" />
                                                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center"
                                                                    Visibility="{Binding IsLoadingChoices, Converter={StaticResource BoolToVisibility}}">
                                                            <local:Spinner Width="14" Height="14" Margin="0,0,8,0" />
                                                            <TextBlock Text="Loading choices from Jira…" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>

                                                <Grid Margin="14,6,14,8"
                                                      Visibility="{Binding DataContext.Editor.IsEditingDetails, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolToVisibility}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Style="{StaticResource FieldName}" Text="Assignee" />
                                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                                        <ContentPresenter Content="{Binding Assignee, TargetNullValue=''}" ContentTemplate="{StaticResource AvatarTemplate}"
                                                                          VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Assignee, TargetNullValue=Unassigned}" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Row="1" Style="{StaticResource FieldName}" Text="Reporter" />
                                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                                        <ContentPresenter Content="{Binding Reporter, TargetNullValue=''}" ContentTemplate="{StaticResource AvatarTemplate}"
                                                                          VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Reporter, TargetNullValue=None}" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Row="2" Style="{StaticResource FieldName}" Text="Priority" />
                                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                                        <ContentPresenter Content="{Binding Priority, TargetNullValue=''}" ContentTemplate="{StaticResource PriorityIconTemplate}"
                                                                          VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Priority, TargetNullValue=None}" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Row="3" Style="{StaticResource FieldName}" Text="Type" />
                                                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                                        <ContentPresenter Content="{Binding Type, TargetNullValue=''}" ContentTemplate="{StaticResource IssueTypeIconTemplate}"
                                                                          VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Type, TargetNullValue=None}" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Row="4" Style="{StaticResource FieldName}" Text="Labels" />
                                                    <Grid Grid.Row="4" Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource FieldValue}" Text="None"
                                                                   Visibility="{Binding Labels.Count, Converter={StaticResource ZeroToVisibility}}" />
                                                        <ItemsControl ItemsSource="{Binding Labels}" Margin="0,4,0,0">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="{StaticResource NeutralButtonBrush}" CornerRadius="3" Padding="6,1" Margin="0,0,6,4">
                                                                        <TextBlock Text="{Binding}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>

                                                    <TextBlock Grid.Row="5" Style="{StaticResource FieldName}" Text="Parent" />
                                                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding ParentKey, TargetNullValue=None}" />
                                                    <TextBlock Grid.Row="6" Style="{StaticResource FieldName}" Text="Created" />
                                                    <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding Created, StringFormat=d MMM yyyy\, HH:mm, TargetNullValue=–}" />
                                                    <TextBlock Grid.Row="7" Style="{StaticResource FieldName}" Text="Updated" />
                                                    <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding Updated, StringFormat=d MMM yyyy\, HH:mm, TargetNullValue=–}" />
                                                    <TextBlock Grid.Row="8" Style="{StaticResource FieldName}" Text="Resolved" />
                                                    <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding Resolved, StringFormat=d MMM yyyy\, HH:mm, TargetNullValue=Not resolved}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Activity -->
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="Activity" />
                                        <TabControl Style="{StaticResource FlatTabs}"
                                                    SelectedIndex="{Binding DataContext.DetailTabIndex, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <TabItem Header="{Binding Comments.Count, Converter={StaticResource Format}, ConverterParameter='Comments ({0})'}">
                                                <StackPanel>
                                                    <!-- New comment: sent only when "Add comment" (or Ctrl+Enter) is pressed -->
                                                    <StackPanel Margin="0,0,0,22"
                                                                DataContext="{Binding DataContext.Editor, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                        <Grid>
                                                            <TextBox Style="{StaticResource TextArea}" MinHeight="72" MaxHeight="300"
                                                                     Text="{Binding CommentDraft, UpdateSourceTrigger=PropertyChanged}"
                                                                     IsEnabled="{Binding CanEdit}" AutomationProperties.Name="New comment">
                                                                <TextBox.InputBindings>
                                                                    <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding AddCommentCommand}" />
                                                                </TextBox.InputBindings>
                                                            </TextBox>
                                                            <TextBlock Style="{StaticResource Placeholder}" Tag="{Binding CommentDraft}" Text="Add a comment…"
                                                                       Margin="12,9,0,0" VerticalAlignment="Top" />
                                                        </Grid>
                                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                            <Button Style="{StaticResource PrimaryButton}" Content="Add comment" Padding="14,6"
                                                                    Command="{Binding AddCommentCommand}" AutomationProperties.Name="Add comment" />
                                                            <TextBlock Text="or press Ctrl+Enter" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <TextBlock Text="No comments yet." FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                                                               Visibility="{Binding Comments.Count, Converter={StaticResource ZeroToVisibility}}" />
                                                    <ItemsControl ItemsSource="{Binding Comments}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <DockPanel Margin="0,0,0,18">
                                                                    <ContentPresenter DockPanel.Dock="Left" Content="{Binding Author, TargetNullValue=''}"
                                                                                      ContentTemplate="{StaticResource AvatarTemplate}" VerticalAlignment="Top" Margin="0,0,12,0">
                                                                        <ContentPresenter.LayoutTransform>
                                                                            <ScaleTransform ScaleX="1.33" ScaleY="1.33" />
                                                                        </ContentPresenter.LayoutTransform>
                                                                    </ContentPresenter>
                                                                    <StackPanel>
                                                                        <TextBlock FontSize="13" Foreground="{StaticResource TextSecondaryBrush}">
                                                                            <Run Text="{Binding Author, Mode=OneWay, TargetNullValue=Someone}" FontWeight="SemiBold"
                                                                                 FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                                                                            <Run Text="{Binding Created, Mode=OneWay, StringFormat=   d MMM yyyy\, HH:mm}" />
                                                                        </TextBlock>
                                                                        <TextBox Text="{Binding Body, Mode=OneWay}" Margin="0,4,0,0" Style="{StaticResource SelectableText}" />
                                                                    </StackPanel>
                                                                </DockPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </TabItem>
                                            <TabItem Header="{Binding Changes.Count, Converter={StaticResource Format}, ConverterParameter='History ({0})'}">
                                                <StackPanel>
                                                    <TextBlock Text="No history fetched." FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                                                               Visibility="{Binding Changes.Count, Converter={StaticResource ZeroToVisibility}}" />
                                                    <ItemsControl ItemsSource="{Binding Changes}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <DockPanel Margin="0,0,0,16">
                                                                    <ContentPresenter DockPanel.Dock="Left" Content="{Binding Author, TargetNullValue=''}"
                                                                                      ContentTemplate="{StaticResource AvatarTemplate}" VerticalAlignment="Top" Margin="0,0,12,0">
                                                                        <ContentPresenter.LayoutTransform>
                                                                            <ScaleTransform ScaleX="1.33" ScaleY="1.33" />
                                                                        </ContentPresenter.LayoutTransform>
                                                                    </ContentPresenter>
                                                                    <StackPanel>
                                                                        <TextBlock FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}">
                                                                            <Run Text="{Binding Author, Mode=OneWay, TargetNullValue=Someone}" FontWeight="SemiBold" />
                                                                            <Run Text="changed the" Foreground="{StaticResource TextSecondaryBrush}" />
                                                                            <Run Text="{Binding Field, Mode=OneWay}" FontWeight="SemiBold" />
                                                                        </TextBlock>
                                                                        <TextBlock FontSize="12" Margin="0,1,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                                                                                   Text="{Binding Created, StringFormat=d MMM yyyy\, HH:mm}" />
                                                                        <TextBlock Margin="0,6,0,0" FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}">
                                                                            <Run Text="{Binding From, Mode=OneWay, TargetNullValue=None}" Foreground="{StaticResource TextSecondaryBrush}"
                                                                                 TextDecorations="Strikethrough" />
                                                                            <Run Text="  →  " Foreground="{StaticResource TextSecondaryBrush}" />
                                                                            <Run Text="{Binding To, Mode=OneWay, TargetNullValue=None}" />
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </DockPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </TabItem>
                                        </TabControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>

                            <local:Spinner Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding IsDetailLoading, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Border>
                </Grid>
            </DockPanel>
        </Grid>

        <!-- Nothing fetched yet -->
        <Border Grid.Row="1" Style="{StaticResource Card}" MaxWidth="520" HorizontalAlignment="Left" VerticalAlignment="Top"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" FontSize="24" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="No Jira data yet" Margin="0,10,0,0" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Margin="0,6,0,18" FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                           Text="Connect to Jira and use Fetch data to download your projects and issues. They'll appear here, and you can browse them offline." />
                <Button Content="Go to Jira" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Command="{Binding GoToJiraPageCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="AICollaborationPlatform.App.Views.JiraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Jira" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
        <TextBlock Margin="0,6,0,24" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                   Text="{Binding ConnectionStatus, StringFormat=Status: {0}}" />

        <Border Style="{StaticResource Card}" MaxWidth="520" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Connect to Jira" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Margin="0,8,0,18" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                           Text="Enter your Jira URL and credentials to connect. The connection dialog is coming in the next story." />
                <Button Content="Connect…" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" IsEnabled="False"
                        ToolTipService.ShowOnDisabled="True" ToolTip="Coming in Story 2" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
